{
  "name": "@codegraph/errors",
  "version": "0.1.0",
  "description": "Shared runtime error model for the CodeGraph/pay2 portfolio",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./problem-details": {
      "import": "./dist/problem-details.js",
      "types": "./dist/problem-details.d.ts"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "types": "./dist/registry.d.ts"
    },
    "./generated": {
      "import": "./dist/generated/error-entities.js",
      "types": "./dist/generated/error-entities.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "entities",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "pack:smoke": "node --import tsx/esm ./test/smoke/pack-smoke.ts",
    "fixture:smoke": "node --import tsx/esm ./test/smoke/fixture-smoke.ts",
    "weazel:generate": "node --import tsx/esm ./test/smoke/weazel-generate.ts"
  },
  "devDependencies": {
    "@codegraph/build": "workspace:*",
    "@codegraph/testing": "workspace:*",
    "@codegraph/weazel": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
