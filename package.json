{
  "name": "ts-codegraph",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Syntax-first TypeScript AST fact extractor, SQLite FTS5 store, and deterministic documentation generator",
  "type": "module",
  "bin": {
    "ts-codegraph": "./dist/bin/ts-codegraph.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:performance": "TS_CODEGRAPH_RUN_PERFORMANCE=1 vitest run test/e2e/performance.e2e.test.ts",
    "emit:schemas": "tsx scripts/emit-schemas.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "handlebars": "4.7.9",
    "ts-morph": "26.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
