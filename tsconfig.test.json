{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": [
      "node",
      "vitest"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/fixtures"
  ]
}
